{
    "app-id": "io.github.stephanlefty.GuideOSBookHub",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "24.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "guideosbookhub",
    "finish-args": [
        "--socket=x11",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=network",
        "--share=ipc",
        "--device=dri",
        "--filesystem=home"
    ],
    "modules": [
        {
            "name": "rclone",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 rclone /app/bin/rclone"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://downloads.rclone.org/rclone-current-linux-amd64.zip",
                    "strip-components": 1
                }
            ]
        },
        {
            "name": "guideosbookhub",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-build-isolation PyQt6 .",
                "install -Dm644 packaging/flatpak/io.github.stephanlefty.GuideOSBookHub.desktop /app/share/applications/io.github.stephanlefty.GuideOSBookHub.desktop",
                "install -Dm644 packaging/flatpak/io.github.stephanlefty.GuideOSBookHub.metainfo.xml /app/share/metainfo/io.github.stephanlefty.GuideOSBookHub.metainfo.xml",
                "install -Dm644 icons/icon-256.png /app/share/icons/hicolor/256x256/apps/io.github.stephanlefty.GuideOSBookHub.png",
                "install -Dm644 icons/icon-128.png /app/share/icons/hicolor/128x128/apps/io.github.stephanlefty.GuideOSBookHub.png",
                "install -Dm644 icons/icon-48.png /app/share/icons/hicolor/48x48/apps/io.github.stephanlefty.GuideOSBookHub.png"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../.."
                }
            ]
        }
    ]
}
